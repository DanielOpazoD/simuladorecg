    },
    "12sl-disputed": {
      "allowedMetrics": [
        "withinLeadRatio"
      ],
      "reason": "Historical paired sample/table amplitude ratio near 1000 conflicts with declared units. Builder raw-alignment route makes a separate claim; neither silently repairs the historical median cohort. Automatic vendor timing is a distinct reference."
    },
    "12sl-tabular": {
      "allowedMetrics": [
        "withinLeadRatio",
        "timing",
        "absoluteAmplitude",
        "crossLeadVoltage"
      ],
      "reason": "Harmonized 12SL/UniG features as documented, descriptive only. ST_Amp is STJ, QRS_AmpPP is peak-to-peak; timing is automatic vendor timing, not independent human annotation."
    },
    "ptbxl-original20-texture": {
      "allowedMetrics": [
        "withinLeadRatio",
        "absoluteAmplitude",
        "crossLeadVoltage"
      ],
      "reason": "20 exposed original records: official byte checksums and headers verify 500 Hz and gain in mV. Texture windows are heuristic; no independent QRS/ST/T annotations or clinical timing validation."
    }
  },
